{
  "hosting": {
    "site": "clipealo-gpt-amigos-dev",
    "public": "out",
    "ignore": [
      "firebase.dev.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/es/",
        "type": 302
      },
      {
        "source": "/en/pricing",
        "destination": "/en/precios/",
        "type": 301
      },
      {
        "source": "/en/pricing/",
        "destination": "/en/precios/",
        "type": 301
      },
      {
        "source": "/pt/precos",
        "destination": "/pt/precios/",
        "type": 301
      },
      {
        "source": "/pt/precos/",
        "destination": "/pt/precios/",
        "type": 301
      },
      {
        "source": "/en/legal/privacy",
        "destination": "/en/legal/privacidad/",
        "type": 301
      },
      {
        "source": "/en/legal/privacy/",
        "destination": "/en/legal/privacidad/",
        "type": 301
      },
      {
        "source": "/pt/legal/privacidade",
        "destination": "/pt/legal/privacidad/",
        "type": 301
      },
      {
        "source": "/pt/legal/privacidade/",
        "destination": "/pt/legal/privacidad/",
        "type": 301
      },
      {
        "source": "/en/legal/terms",
        "destination": "/en/legal/terminos/",
        "type": 301
      },
      {
        "source": "/en/legal/terms/",
        "destination": "/en/legal/terminos/",
        "type": 301
      },
      {
        "source": "/pt/legal/termos",
        "destination": "/pt/legal/terminos/",
        "type": 301
      },
      {
        "source": "/pt/legal/termos/",
        "destination": "/pt/legal/terminos/",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow, noarchive"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  }
}
