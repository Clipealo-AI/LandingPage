    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "hls.js": "^1.7.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "radix-ui": "^1.6.7",
