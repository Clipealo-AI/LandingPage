{
  "name": "clipealo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:landing": "vite --host 0.0.0.0",
    "build": "next build",
    "build:landing": "vite build",
    "build:landing:dev": "VITE_DEPLOY_ENV=dev vite build --mode dev && node scripts/write-dev-robots.mjs",
    "start": "next start -p 3100",
    "preview:landing": "vite preview --host 0.0.0.0",
    "lint": "eslint",
    "lint:landing": "eslint --config eslint.landing.config.mjs src vite.config.ts",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "typecheck:landing": "tsc --noEmit --project tsconfig.app.json",
    "check:landing": "bun run typecheck:landing && bun run lint:landing && bun run build:landing",
    "ui:add": "shadcn add",
    "analyze": "ANALYZE=true next build",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.18.2",
    "hls.js": "^1.7.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^6.30.6",
    "react-resizable-panels": "^4.12.4",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@formatjs/icu-messageformat-parser": "^3.5.18",
    "@next/bundle-analyzer": "^16.3.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "autoprefixer": "^10.5.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-legacy": "npm:tailwindcss@^3.4.19",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.21",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
